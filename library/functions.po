#: library/functions.rst:1569
msgid "*fget* is a function for getting an attribute value.  *fset* is a function for setting an attribute value. *fdel* is a function for deleting an attribute value.  And *doc* creates a docstring for the attribute."
msgstr "* fget* একটি বৈশিষ্ট্য মান পাওয়ার জন্য একটি ফাংশন।* fset* একটি বৈশিষ্ট্য মান নির্ধারণের জন্য একটি ফাংশন।* fdel* একটি বৈশিষ্ট্য মান মোছার জন্য একটি ফাংশন।এবং * ডক * বৈশিষ্ট্যের জন্য একটি ডকস্ট্রিং তৈরি করে।"

#: library/functions.rst:1573
msgid "A typical use is to define a managed attribute ``x``::"
msgstr "একটি সাধারণ ব্যবহার হ'ল একটি পরিচালিত বৈশিষ্ট্য `` x`` :: সংজ্ঞায়িত করা"

#: library/functions.rst:1575
msgid "class C:
    def __init__(self):
        self._x = None

    def getx(self):
        return self._x

    def setx(self, value):
        self._x = value

    def delx(self):
        del self._x

    x = property(getx, setx, delx, "I'm the 'x' property.")"
msgstr "ক্লাস সি: Def __init __ (স্ব): স্ব ।_এক্স = কিছুই নয় ডিএফ গেটেক্স (স্ব): ফিরে স্ব ডিএফ সেটেক্স (স্ব, মান): স্ব ।_এক্স = মান ডিএফ ডেলেক্স (স্ব): ডেল স্ব x = সম্পত্তি (getx, Setx, DELX, "আমি 'এক্স' সম্পত্তি" ")"

#: library/functions.rst:1590
